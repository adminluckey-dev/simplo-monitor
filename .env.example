# NX Witness Media Server
NX_HOST=https://127.0.0.1:7001
NX_USERNAME=admin
NX_PASSWORD=ganti_dengan_password_nx

# Dashboard web server
APP_HOST=0.0.0.0
APP_PORT=8080

# Site branding
SITE_NAME=CMMS
SITE_SITE=Menara SVT
SITE_ORG=MK Manajemen Gedung

# Poll interval shown in UI / cache TTL (seconds)
POLL_SECONDS=10

# Set true to show sample data when NX login fails
DEMO_FALLBACK=true

# WiFi / LTE router gateway monitoring
ROUTER_MONITOR=true
ROUTER_IP=192.168.1.1
ROUTER_NAME=WIFI-GW-01
ROUTER_LOCATION=Gateway WiFi CMMS
ROUTER_SSID=CMMS
# Optional: isi untuk detail lebih lengkap via API admin router (Digest)
ROUTER_USERNAME=admin
ROUTER_PASSWORD=

# Notifikasi email/Telegram dikonfigurasi lewat UI:
# menu "Setting Notifikasi" (disimpan di data/notify_settings.json)
